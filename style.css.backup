* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #05070d;
  --surface: rgba(12, 17, 29, 0.72);
  --surface-strong: #0d1320;
  --text: #f4f7fb;
  --muted: #96a0b4;
  --line: rgba(255, 255, 255, 0.09);
  --cyan: #74e7f6;
  --violet: #9c8cff;
  --green: #74e6ad;
  --max: 1180px;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(circle at 73% 9%, rgba(76, 91, 255, 0.14), transparent 28rem),
    radial-gradient(circle at 18% 39%, rgba(66, 220, 239, 0.07), transparent 26rem),
    var(--bg);
  color: var(--text);
  font-family: "DM Sans", system-ui, sans-serif;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: linear-gradient(to bottom, black, transparent 84%);
  z-index: -2;
}

.noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.045;
  z-index: 20;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E");
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.site-header {
  width: min(var(--max), calc(100% - 48px));
  margin: 0 auto;
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  position: relative;
  z-index: 10;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: "Space Grotesk", sans-serif;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brand-mark {
  width: 27px;
  height: 27px;
  border: 1px solid rgba(116, 231, 246, 0.6);
  border-radius: 9px;
  transform: rotate(45deg);
  display: grid;
  place-items: center;
  box-shadow: 0 0 28px rgba(116, 231, 246, 0.18);
}

.brand-mark span {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--cyan), var(--violet));
}

.nav {
  display: flex;
  align-items: center;
  gap: 34px;
  color: #adb5c7;
  font-size: 14px;
}

.nav a,
.header-cta {
  transition: color 180ms ease, transform 180ms ease, border-color 180ms ease, background 180ms ease;
}

.nav a:hover {
  color: var(--text);
}

.header-cta {
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.035);
  padding: 11px 15px;
  border-radius: 999px;
  font-size: 13px;
}

.header-cta:hover {
  border-color: rgba(116, 231, 246, 0.35);
  transform: translateY(-1px);
}

.section {
  width: min(var(--max), calc(100% - 48px));
  margin: 0 auto;
}

.hero {
  min-height: 700px;
  padding: 76px 0 100px;
  display: grid;
  grid-template-columns: 1.02fr 0.98fr;
  align-items: center;
  gap: 60px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #9ca7bc;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 16px var(--cyan);
}

.hero h1,
.section-heading h2,
.closing-card h2 {
  font-family: "Space Grotesk", sans-serif;
  letter-spacing: -0.052em;
  line-height: 0.98;
}

.hero h1 {
  font-size: clamp(62px, 7.8vw, 108px);
  margin: 25px 0;
  max-width: 720px;
}

em {
  color: transparent;
  font-style: normal;
  background: linear-gradient(100deg, #ffffff 0%, #94eefe 50%, #aaa0ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
}

.hero-text {
  max-width: 590px;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 30px 0 18px;
}

.btn {
  border-radius: 999px;
  padding: 14px 19px;
  display: inline-flex;
  align-items: center;
  gap: 11px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  color: #061016;
  background: linear-gradient(105deg, #b9fbff, #91e7ff 48%, #c8bcff);
  box-shadow: 0 16px 46px rgba(94, 217, 245, 0.16);
  font-weight: 700;
}

.btn-primary:hover {
  box-shadow: 0 20px 58px rgba(94, 217, 245, 0.24);
}

.btn-ghost {
  border-color: var(--line);
  background: rgba(255,255,255,0.025);
  color: #d9deea;
}

.btn-ghost:hover {
  border-color: rgba(255,255,255,0.18);
}

.hero-note {
  color: #667086;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.tiny-shield {
  color: var(--cyan);
}

.hero-visual {
  height: 610px;
  position: relative;
  display: grid;
  place-items: center;
}

.hero-grid {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(116,231,246,0.11) 1px, transparent 1px);
  background-size: 14px 14px;
  mask-image: radial-gradient(circle, black 10%, transparent 68%);
  opacity: 0.75;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(45px);
  opacity: 0.42;
}

.orb-a {
  width: 220px;
  height: 220px;
  background: #3bcce8;
  right: 30px;
  top: 120px;
}

.orb-b {
  width: 180px;
  height: 180px;
  background: #7f6fff;
  left: 70px;
  bottom: 90px;
}

.phone {
  width: 310px;
  height: 590px;
  border-radius: 38px;
  padding: 10px;
  background: linear-gradient(145deg, #172132, #05070c 70%);
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow:
    0 35px 100px rgba(0,0,0,0.6),
    0 0 0 8px rgba(255,255,255,0.025),
    0 0 80px rgba(72, 209, 238, 0.12);
  transform: rotate(3deg);
  position: relative;
  z-index: 4;
}

.phone::before {
  content: "";
  position: absolute;
  width: 92px;
  height: 22px;
  border-radius: 0 0 17px 17px;
  background: #06070b;
  top: 9px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
}

.phone-top {
  height: 34px;
  padding: 2px 13px 0;
  font-size: 10px;
  color: #b7bfd0;
  display: flex;
  justify-content: space-between;
}

.phone-screen {
  height: calc(100% - 34px);
  border-radius: 30px;
  overflow: hidden;
  background: linear-gradient(180deg, #0d131f, #080c14);
  border: 1px solid rgba(255,255,255,0.04);
}

.feed-head {
  padding: 16px 14px;
  display: grid;
  grid-template-columns: 28px 1fr auto;
  align-items: center;
  gap: 9px;
  font-size: 11px;
}

.avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #263d55, #8aa7ba);
  color: white;
  font-weight: 700;
}

.more {
  color: #8b94a8;
  letter-spacing: 2px;
}

.post-media {
  height: 258px;
  position: relative;
}

.fake-image {
  position: absolute;
  inset: 0;
  background: linear-gradient(155deg, #203e4f 0%, #16334b 50%, #0b1521 100%);
  overflow: hidden;
}

.sun {
  position: absolute;
  width: 65px;
  height: 65px;
  border-radius: 50%;
  background: radial-gradient(circle, #e7fbff, #94d6ea 47%, transparent 49%);
  right: 36px;
  top: 38px;
  filter: blur(1px);
}

.mountain {
  position: absolute;
  bottom: 54px;
  width: 0;
  height: 0;
  border-left: 115px solid transparent;
  border-right: 115px solid transparent;
  border-bottom: 145px solid #172938;
}

.m1 { left: -30px; }
.m2 {
  right: -35px;
  border-left-width: 145px;
  border-right-width: 145px;
  border-bottom-color: #203949;
}

.lake {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 95px;
  background: linear-gradient(180deg, rgba(65, 159, 190, 0.48), rgba(11, 30, 47, 0.95));
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 34%;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(116,231,246,0.95), transparent);
  box-shadow: 0 0 24px rgba(116,231,246,0.7);
  animation: scan 2.8s infinite ease-in-out;
}

.ai-badge {
  position: absolute;
  left: 12px;
  top: 12px;
  padding: 6px 9px;
  border-radius: 999px;
  background: rgba(3,8,15,0.64);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(116,231,246,0.2);
  color: #bcf9ff;
  font-size: 9px;
}

.post-meta {
  padding: 11px 13px 8px;
  display: flex;
  justify-content: space-between;
  color: #8892a8;
  font-size: 10px;
}

.post-meta div {
  display: flex;
  gap: 12px;
  font-size: 15px;
  color: #d8deeb;
}

.verification-card {
  margin: 8px 12px;
  padding: 13px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(16, 24, 37, 0.78);
  backdrop-filter: blur(14px);
  border-radius: 16px;
}

.mini-label {
  font-size: 8px;
  color: #7f8aa0;
  letter-spacing: 0.15em;
  font-weight: 700;
}

.assessment-row {
  margin: 8px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.assessment-row strong {
  font-size: 11px;
}

.confidence {
  font-size: 10px;
  color: #ffd98c;
}

.meter {
  height: 4px;
  border-radius: 999px;
  background: #20293a;
  overflow: hidden;
}

.meter span {
  display: block;
  width: 78%;
  height: 100%;
  background: linear-gradient(90deg, #74e6ad, #ffd98c);
}

.verification-card small {
  color: #6e798f;
  font-size: 9px;
  display: block;
  margin-top: 8px;
}

.floating-chip {
  position: absolute;
  z-index: 5;
  min-width: 164px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 13px;
  border-radius: 17px;
  background: rgba(11, 17, 29, 0.74);
  border: 1px solid rgba(255,255,255,0.1);
  backdrop-filter: blur(20px);
  box-shadow: 0 18px 44px rgba(0,0,0,0.25);
}

.chip-top {
  top: 130px;
  right: 0;
}

.chip-bottom {
  bottom: 106px;
  left: 0;
}

.chip-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  color: #b9fbff;
  background: rgba(116,231,246,0.08);
  border: 1px solid rgba(116,231,246,0.16);
}

.floating-chip small {
  display: block;
  font-size: 9px;
  color: #6f7b90;
}

.floating-chip strong {
  display: block;
  font-size: 11px;
  margin-top: 2px;
}

.trust-strip {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  min-height: 92px;
  padding: 0 max(24px, calc((100vw - var(--max)) / 2));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  color: #68748a;
  font-size: 10px;
  letter-spacing: 0.14em;
  font-weight: 700;
}

.type-pills {
  display: flex;
  gap: 10px;
}

.type-pills span {
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 10px 14px;
  color: #a9b2c3;
}

.problem,
.how,
.verifier {
  padding: 150px 0;
}

.section-heading {
  max-width: 720px;
}

.section-heading.centered {
  text-align: center;
  margin-inline: auto;
}

.section-heading h2 {
  margin: 20px 0 20px;
  font-size: clamp(48px, 6vw, 76px);
}

.section-heading p {
  max-width: 630px;
  color: var(--muted);
  line-height: 1.75;
  font-size: 16px;
}

.section-heading.centered p {
  margin-inline: auto;
}

.problem-cards {
  margin-top: 70px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.info-card,
.how-step {
  border: 1px solid var(--line);
  background: linear-gradient(145deg, rgba(15, 22, 35, 0.8), rgba(7, 11, 18, 0.7));
  border-radius: 24px;
  padding: 28px;
  min-height: 235px;
  transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
}

.info-card:hover,
.how-step:hover {
  transform: translateY(-5px);
  border-color: rgba(116,231,246,0.18);
  background: linear-gradient(145deg, rgba(18, 28, 44, 0.85), rgba(8, 12, 20, 0.78));
}

.card-icon,
.how-step > span {
  font-family: "Space Grotesk", sans-serif;
  font-size: 13px;
  color: var(--cyan);
}

.info-card h3,
.how-step h3 {
  margin: 57px 0 10px;
  font-family: "Space Grotesk", sans-serif;
  font-size: 22px;
  letter-spacing: -0.03em;
}

.info-card p,
.how-step p {
  color: var(--muted);
  line-height: 1.7;
  font-size: 14px;
}

.verifier-shell {
  margin-top: 65px;
  max-width: 940px;
  margin-inline: auto;
  border: 1px solid var(--line);
  border-radius: 32px;
  background: rgba(8, 13, 23, 0.72);
  box-shadow: 0 35px 100px rgba(0,0,0,0.35);
  padding: 16px;
  overflow: hidden;
}

.media-tabs {
  display: flex;
  gap: 6px;
  padding: 7px;
  background: rgba(255,255,255,0.025);
  border: 1px solid var(--line);
  border-radius: 17px;
  width: fit-content;
  margin-bottom: 16px;
}

.media-tab {
  border: 0;
  background: transparent;
  color: #7e899f;
  border-radius: 12px;
  padding: 10px 15px;
  cursor: pointer;
}

.media-tab.active {
  color: #071016;
  background: linear-gradient(100deg, #bbfbff, #c7bcff);
  font-weight: 700;
}

.drop-zone {
  min-height: 400px;
  border: 1px dashed rgba(145, 158, 179, 0.24);
  border-radius: 25px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 50%, rgba(116,231,246,0.07), transparent 26rem),
    rgba(255,255,255,0.012);
}

.drop-zone.dragging {
  border-color: rgba(116,231,246,0.55);
  background: rgba(116,231,246,0.04);
}

.drop-glow {
  position: absolute;
  inset: auto 20% -55% 20%;
  height: 300px;
  border-radius: 50%;
  background: rgba(120, 127, 255, 0.15);
  filter: blur(70px);
}

.upload-icon {
  width: 68px;
  height: 68px;
  display: grid;
  place-items: center;
  border-radius: 21px;
  border: 1px solid rgba(116,231,246,0.2);
  background: rgba(116,231,246,0.06);
  color: var(--cyan);
  font-size: 26px;
  position: relative;
  z-index: 1;
}

.drop-zone h3 {
  position: relative;
  z-index: 1;
  margin: 20px 0 8px;
  font-family: "Space Grotesk", sans-serif;
  font-size: 25px;
}

.drop-zone p,
.supported {
  position: relative;
  z-index: 1;
  color: #6f7b90;
  font-size: 13px;
}

.upload-btn {
  margin: 20px 0 11px;
  position: relative;
  z-index: 1;
}

.supported {
  font-size: 10px;
}

.analysis-panel,
.result-panel {
  border: 1px solid var(--line);
  border-radius: 24px;
  margin-top: 12px;
  padding: 25px;
  background: rgba(255,255,255,0.02);
}

.analysis-top,
.result-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
}

.analysis-top h3,
.result-main h3 {
  font-family: "Space Grotesk", sans-serif;
  font-size: 26px;
  margin-top: 8px;
  max-width: 650px;
}

.status-pill {
  border: 1px solid rgba(116,231,246,0.18);
  color: var(--cyan);
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.analysis-visual {
  margin: 34px auto;
  width: 190px;
  height: 190px;
  position: relative;
  display: grid;
  place-items: center;
}

.scan-ring {
  position: absolute;
  inset: 7px;
  border-radius: 50%;
  border: 1px solid rgba(116,231,246,0.28);
  border-top-color: transparent;
  animation: rotate 2.2s linear infinite;
}

.scan-ring::after {
  content: "";
  position: absolute;
  inset: 16px;
  border-radius: 50%;
  border: 1px dashed rgba(156,140,255,0.32);
  animation: rotateReverse 3.8s linear infinite;
}

.scan-core {
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(188,252,255,0.95), rgba(116,231,246,0.18) 42%, transparent 70%);
  box-shadow: 0 0 60px rgba(116,231,246,0.2);
}

.analysis-text {
  position: absolute;
  font-family: "Space Grotesk", sans-serif;
  font-size: 26px;
}

.data-node {
  position: absolute;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--violet);
  box-shadow: 0 0 22px rgba(156,140,255,0.7);
  animation: nodePulse 1.7s infinite ease-in-out;
}

.n1 { top: 27px; left: 73px; }
.n2 { top: 84px; right: 21px; animation-delay: .2s; }
.n3 { bottom: 33px; right: 71px; animation-delay: .4s; }
.n4 { bottom: 67px; left: 18px; animation-delay: .6s; }

.analysis-steps {
  display: grid;
  gap: 8px;
}

.step {
  display: grid;
  grid-template-columns: 38px 1fr auto;
  align-items: center;
  gap: 12px;
  padding: 13px;
  border-radius: 15px;
  border: 1px solid rgba(255,255,255,0.06);
  color: #a2adbe;
}

.step.active {
  border-color: rgba(116,231,246,0.15);
  background: rgba(116,231,246,0.035);
}

.step > span {
  color: #58657b;
  font-size: 10px;
}

.step strong,
.step small {
  display: block;
}

.step strong {
  font-size: 12px;
}

.step small {
  color: #68758b;
  font-size: 10px;
  margin-top: 2px;
}

.step b {
  opacity: 0;
  color: var(--green);
  font-size: 13px;
}

.step.done b {
  opacity: 1;
}

.result-badge {
  display: inline-flex;
  border: 1px solid rgba(116,230,173,0.2);
  background: rgba(116,230,173,0.06);
  color: var(--green);
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 9px;
  letter-spacing: 0.14em;
  font-weight: 700;
}

.result-main {
  margin-top: 22px;
}

.result-main p {
  margin-top: 11px;
  color: var(--muted);
  line-height: 1.7;
  max-width: 650px;
  font-size: 14px;
}

.score-ring {
  flex: 0 0 120px;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  align-content: center;
  border: 1px solid rgba(255, 217, 140, 0.25);
  background: radial-gradient(circle, rgba(255,217,140,0.08), transparent 64%);
  box-shadow: inset 0 0 34px rgba(255,217,140,0.04);
}

.score-ring span {
  font-family: "Space Grotesk", sans-serif;
  font-size: 33px;
}

.score-ring small {
  color: #6f7b90;
  margin-top: -3px;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 25px;
}

.result-grid div {
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 13px;
}

.result-grid span,
.result-grid strong {
  display: block;
}

.result-grid span {
  color: #67748a;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.result-grid strong {
  margin-top: 7px;
  font-size: 12px;
}

.result-foot {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
}

.result-foot > span {
  color: #606d83;
  font-size: 11px;
  line-height: 1.5;
}

.result-foot .btn {
  flex: 0 0 auto;
  padding: 10px 13px;
  font-size: 11px;
}

.steps-grid {
  margin-top: 65px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.how-step {
  min-height: 270px;
}

.how-step h3 {
  margin-top: 72px;
}

.closing {
  padding: 20px 0 130px;
}

.closing-card {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 120px 30px;
  border: 1px solid var(--line);
  border-radius: 34px;
  background:
    radial-gradient(circle at 50% 0%, rgba(116,231,246,0.12), transparent 30rem),
    radial-gradient(circle at 50% 110%, rgba(156,140,255,0.12), transparent 26rem),
    rgba(9, 13, 22, 0.75);
}

.closing-card h2 {
  font-size: clamp(52px, 7vw, 86px);
  margin: 20px 0;
}

.closing-card p {
  color: var(--muted);
  margin: 0 auto 26px;
  max-width: 560px;
  line-height: 1.75;
}

.closing-particles {
  position: absolute;
  inset: 0;
  opacity: 0.5;
  background:
    radial-gradient(circle at 17% 25%, rgba(116,231,246,.8) 0 1px, transparent 2px),
    radial-gradient(circle at 28% 64%, rgba(156,140,255,.9) 0 1px, transparent 2px),
    radial-gradient(circle at 80% 22%, rgba(116,231,246,.7) 0 1px, transparent 2px),
    radial-gradient(circle at 69% 78%, rgba(156,140,255,.8) 0 1px, transparent 2px);
  background-size: 200px 200px, 240px 240px, 260px 260px, 190px 190px;
}

.closing-card > *:not(.closing-particles) {
  position: relative;
  z-index: 1;
}

.footer {
  width: min(var(--max), calc(100% - 48px));
  margin: 0 auto;
  padding: 26px 0 38px;
  border-top: 1px solid var(--line);
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 24px;
  align-items: center;
  color: #657188;
  font-size: 11px;
}

@keyframes scan {
  0%, 100% { transform: translateY(-35px); opacity: 0; }
  20%, 80% { opacity: 1; }
  50% { transform: translateY(185px); }
}

@keyframes rotate {
  to { transform: rotate(360deg); }
}

@keyframes rotateReverse {
  to { transform: rotate(-360deg); }
}

@keyframes nodePulse {
  0%, 100% { transform: scale(0.8); opacity: .5; }
  50% { transform: scale(1.25); opacity: 1; }
}

@media (max-width: 980px) {
  .nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 55px;
  }

  .hero-visual {
    height: 570px;
  }

  .hero-copy {
    text-align: center;
  }

  .hero-text,
  .hero-note {
    margin-inline: auto;
    justify-content: center;
  }

  .hero-actions {
    justify-content: center;
  }

  .problem-cards,
  .steps-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .site-header,
  .section,
  .footer {
    width: min(100% - 28px, var(--max));
  }

  .site-header {
    min-height: 74px;
  }

  .header-cta {
    padding: 9px 12px;
    font-size: 11px;
  }

  .hero {
    padding-top: 35px;
    gap: 25px;
  }

  .hero h1 {
    font-size: clamp(54px, 17vw, 80px);
  }

  .hero-text {
    font-size: 15px;
  }

  .hero-visual {
    height: 520px;
  }

  .phone {
    width: 270px;
    height: 515px;
  }

  .floating-chip {
    min-width: 145px;
    padding: 9px 10px;
  }

  .chip-top {
    top: 70px;
    right: -4px;
  }

  .chip-bottom {
    bottom: 52px;
    left: -4px;
  }

  .trust-strip {
    padding: 20px 14px;
    align-items: flex-start;
    flex-direction: column;
  }

  .problem,
  .how,
  .verifier {
    padding: 105px 0;
  }

  .section-heading h2 {
    font-size: 49px;
  }

  .problem-cards,
  .steps-grid,
  .result-grid {
    grid-template-columns: 1fr;
  }

  .info-card,
  .how-step {
    min-height: 210px;
  }

  .verifier-shell {
    padding: 10px;
    border-radius: 25px;
  }

  .drop-zone {
    min-height: 340px;
  }

  .analysis-panel,
  .result-panel {
    padding: 18px;
  }

  .analysis-top,
  .result-main,
  .result-foot {
    flex-direction: column;
    align-items: flex-start;
  }

  .score-ring {
    align-self: flex-end;
  }

  .result-foot .btn {
    width: 100%;
    justify-content: center;
  }

  .footer {
    grid-template-columns: 1fr;
    gap: 10px;
  }
}
